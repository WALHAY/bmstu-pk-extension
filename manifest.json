{
  "manifest_version": 3,
  "name": "BMSTU Priemka Call Assistant",
  "version": "1.0",
  "description": "Добавляет кнопку набора на pk.eu.bmstu.ru и управляет mute/unmute звонка и Яндекс Музыки по статусу вызова.",
  "permissions": [
    "tabs",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pk.eu.bmstu.ru/*",
    "https://mail.bmstu.ru/*",
    "https://*.bmstu.ru/*",
    "https://music.yandex.ru/*",
    "https://yandex.ru/music/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BMSTU Call Assistant Settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pk.eu.bmstu.ru/*"],
      "js": ["dialer-content.js"],
      "run_at": "document_idle"
    }
  ]
}
