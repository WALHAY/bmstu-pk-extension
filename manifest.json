{
  "manifest_version": 3,
  "name": "BMSTU Call Muter",
  "version": "5.0",
  "description": "Мутит вкладку звонка до соединения, а после соединяет — мутит Яндекс Музыку.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://mail.bmstu.ru/*",
    "https://*.bmstu.ru/*",
    "https://music.yandex.ru/*",
    "https://yandex.ru/music/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.bmstu.ru/*", "https://*.bmstu.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
