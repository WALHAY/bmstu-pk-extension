{
  "manifest_version": 3,
  "name": "Yandex Music Muter for BMSTU Call",
  "version": "3.1",
  "description": "Мутит Яндекс Музыку при статусе 'Соединено' и размучивает при окончании звонка.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.bmstu.ru/*",
    "http://mail.bmstu.ru/*",
    "https://*.bmstu.ru/*",
    "https://music.yandex.ru/*",
    "https://yandex.ru/music/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.bmstu.ru/*",
        "http://mail.bmstu.ru/*",
        "https://*.bmstu.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
